# --- Windows build artifacts & debug symbols (#1184) ---
# MSVC / Visual Studio
*.pdb
*.ilk
*.idb
*.obj
*.lib
*.exp
*.map
# MSVC incremental linker files
*.vc.db
*.vc.vc.db
*.vcxproj.user
*.vcxproj.filters
# MSBuild / VS generated folders
# NOTE: a bare "[Dd]ebug/" pattern was removed here — it recursively matched
# every directory named "debug" anywhere in the repo (internal/debug,
# src/debug, erst-ui/src/app/debug, erst-ui/src/app/api/debug), silently
# keeping new files under erst-ui's debug route out of version control.
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
ipch/
*.aps
# CodeView debug info embedded in object files
*.pchi
# Windows-specific crash/dump artefacts
*.dmp
*.stackdump
# MinGW / Cygwin
*.a
*.o
# Generated resource files
Resource.rc
# Windows Installer artefacts
*.msi
*.msix
*.cab

# Erst local debugging artifacts
.erst/cache/
.erst/snapshots/
.erst/traces/
*.trace.json
*.flamegraph.svg
*.flamegraph.html
.npm-cache/

# --- One-off working artifacts committed by mistake ---
# Saved PR diffs, captured tool output and ad-hoc reports. These are produced
# while debugging and have no business in history.
/pr_*_diff.txt
/macos-failed.log
clippy_output.txt
/dummy.wasm
/dummy.xdr

# --- Build outputs not covered above ---
/erst-sim
/bin/erst-sim
*.test
__debug_bin*
.next/
out/
/playground-api/dist/

# --- Coverage / profiling output ---
*.lcov
*.cover
coverage.html
*.prof
*.pprof
.nyc_output/

# --- Re-include real source files hidden by the blanket rules above ---
# `*.json` and `*.py` further up are deliberately broad, but they also keep
# NEW files under these paths out of version control without any warning —
# the same trap the "[Dd]ebug/" pattern caused. Everything the repo actually
# tracks under these paths must be negated explicitly, or `git add` silently
# does nothing. Add a line here whenever a new tracked .json/.py appears.
!docs/schema/*.json
!examples/*.json
!erst_extension/.eslintrc.json
!internal/simulator/perf_baseline.json
!testdata/golden/*.json
!scripts/*.py
